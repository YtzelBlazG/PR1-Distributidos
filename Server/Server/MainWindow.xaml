<Window x:Class="Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Title="Monitor Nacional de Almacenamiento" Height="Auto" Width="Auto"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="10" ShadowDepth="2" Opacity="0.4" />


        <Style x:Key="LabelTitle" TargetType="Label">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LabelInfo" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#42A5F5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>


        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                          From="0.4" To="1" Duration="0:0:6" AutoReverse="True" />
        </Storyboard>


        <Style TargetType="Button" x:Key="WindowButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Opacity="0.2"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1B263B" Offset="0.0"/>
                <GradientStop Color="#415A77" Offset="0.5"/>
                <GradientStop Color="#778DA9" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>
        <DockPanel VerticalAlignment="Top" Background="Transparent" Height="40">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,10,0">
                <Button x:Name="btnMinimizar" Click="btnMinimizar_Click" Style="{StaticResource WindowButton}" Content="─"/>
                <Button x:Name="btmMaximize" Click="btmMaximize_Click" Style="{StaticResource WindowButton}" Content="▢"/>
                <Button x:Name="btnClose" Click="btnClose_Click" Style="{StaticResource WindowButton}" Content="X"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Orientation="Vertical" Margin="10">
            <Label x:Name="lblTitle" Content="Monitor Nacional de Almacenamiento" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0" Foreground="White"/>
            <Label x:Name="lblStorage" Content="Calculando..." FontSize="14" HorizontalAlignment="Center" Foreground="#FF42A5F5" />
            <Label x:Name="lblReport" Content="Esperando reporte..." FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#FF42A5F5" />

            <Label x:Name="lblInfo" Content="Servidor:" HorizontalAlignment="Center" FontSize="14" Width="780" Height="50" Margin="10,0,10,0" Foreground="White" />

            <UniformGrid Columns="3" HorizontalAlignment="Center" x:Name="StorageGrid">

            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
